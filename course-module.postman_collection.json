{
  "info": {
    "_postman_id": "3476fe5b-0c47-45fd-b538-c51130b9f251",
    "name": "Online Course Platform - Course Module",
    "description": "Public catalog, instructor course management, and admin moderation/category APIs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "instructorToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "courseSlug", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "categorySlug", "value": "java" }
  ],
  "item": [
    {
      "name": "Public",
      "item": [
        {
          "name": "Browse published courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/courses?page=0&size=20&keyword=spring&category={{categorySlug}}&level=INTERMEDIATE&language=Vietnamese&minPrice=0&maxPrice=500000"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Returns 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get published course",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/courses/{{courseSlug}}" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Returns 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get category tree",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories" },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Returns 200', () => pm.response.to.have.status(200));"]
              }
            }
          ]
        },
        {
          "name": "Get category",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories/{{categorySlug}}" }
        },
        {
          "name": "Get category courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories/{{categorySlug}}/courses?page=0&size=20"
          }
        }
      ]
    },
    {
      "name": "Instructor",
      "item": [
        {
          "name": "Create course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Spring Boot Masterclass\",\n  \"shortDescription\": \"Build production-ready backend applications with Spring Boot.\",\n  \"description\": \"Learn Spring Boot, PostgreSQL, Redis and Kafka.\",\n  \"price\": 499000,\n  \"level\": \"INTERMEDIATE\",\n  \"language\": \"Vietnamese\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/courses"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('courseId', data.id);",
                  "pm.collectionVariables.set('courseSlug', data.slug);"
                ]
              }
            }
          ]
        },
        {
          "name": "List my courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses?page=0&size=20"
          }
        },
        {
          "name": "Get my course",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}"
          }
        },
        {
          "name": "Update course",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shortDescription\": \"Build production-ready Spring Boot services.\",\n  \"description\": \"Complete backend course with PostgreSQL, Redis, Kafka and Docker.\",\n  \"price\": 499000,\n  \"level\": \"INTERMEDIATE\",\n  \"language\": \"Vietnamese\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": ["pm.test('Returns 204', () => pm.response.to.have.status(204));"]
              }
            }
          ]
        },
        {
          "name": "Replace categories",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"categoryIds\": [\"{{categoryId}}\"]\n}" },
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/categories"
          }
        },
        {
          "name": "Replace requirements",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"content\": \"Basic Java knowledge\", \"sortOrder\": 0 },\n    { \"content\": \"Familiarity with SQL\", \"sortOrder\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/requirements"
          }
        },
        {
          "name": "Replace learning outcomes",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"content\": \"Build REST APIs with Spring Boot\", \"sortOrder\": 0 },\n    { \"content\": \"Design PostgreSQL databases\", \"sortOrder\": 1 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/learning-outcomes"
          }
        },
        {
          "name": "Update thumbnail",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"thumbnail_url\": \"courses/thumbnails/spring-boot.png\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/thumbnail"
          }
        },
        {
          "name": "Submit for review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/submit-review"
          }
        },
        {
          "name": "Pause own course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/pause"
          }
        },
        {
          "name": "Resume own course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/resume"
          }
        },
        {
          "name": "Archive own course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/archive"
          }
        },
        {
          "name": "Delete draft course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}"
          }
        }
      ]
    },
    {
      "name": "Admin Courses",
      "item": [
        {
          "name": "List courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/courses?page=0&size=20&status=PENDING_REVIEW"
          }
        },
        {
          "name": "Get course",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/courses/{{courseId}}"
          }
        },
        {
          "name": "Approve course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/courses/{{courseId}}/approve"
          }
        },
        {
          "name": "Reject course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Course description needs more detail\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/courses/{{courseId}}/reject"
          }
        },
        {
          "name": "Pause course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/courses/{{courseId}}/pause"
          }
        },
        {
          "name": "Archive course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/courses/{{courseId}}/archive"
          }
        }
      ]
    },
    {
      "name": "Admin Categories",
      "item": [
        {
          "name": "Create category",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Java\",\n  \"slug\": \"java\",\n  \"description\": \"Java programming courses\",\n  \"parentId\": null\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/categories"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('categoryId', data.id);",
                  "pm.collectionVariables.set('categorySlug', data.slug);"
                ]
              }
            }
          ]
        },
        {
          "name": "Update category",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Java and JVM ecosystem courses\",\n  \"clearParent\": false\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}"
          }
        },
        {
          "name": "Delete category",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/categories/{{categoryId}}"
          }
        }
      ]
    }
  ]
}
