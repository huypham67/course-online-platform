    {
      "name": "Instructor",
      "item": [
        {
          "name": "Get my instructor profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json().data).to.exist;"
                ]
              }
            }
          ]
        },
        {
          "name": "Update my instructor profile",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"John Smith\",\n  \"bio\": \"I build scalable backend systems and teach practical engineering.\",\n  \"phone\": \"+12025550123\",\n  \"headline\": \"Senior Java Backend Engineer & Technical Instructor\",\n  \"expertise\": \"Java, Spring Boot, Microservices, PostgreSQL\",\n  \"experienceYears\": 8,\n  \"websiteUrl\": \"https://johnsmith.dev\",\n  \"linkedinUrl\": \"https://www.linkedin.com/in/johnsmith\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.expect(pm.response.json().data).to.eql(null);"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve instructor (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/admin/{{instructorId}}/approve"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns compact instructor status', function () { const data = pm.response.json().data; pm.expect(data.id).to.eql(pm.collectionVariables.get('instructorId')); pm.expect(data.instructor_status).to.eql('APPROVED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject instructor (admin)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/admin/{{instructorId}}/reject"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "pm.test('Returns compact instructor status', function () { const data = pm.response.json().data; pm.expect(data.id).to.eql(pm.collectionVariables.get('instructorId')); pm.expect(data.instructor_status).to.eql('REJECTED'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Course Public",
      "item": [
        {
          "name": "Browse published courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/courses?page=0&size=20&category={{categorySlug}}"
          }
        },
        {
          "name": "Get published course",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/courses/{{courseSlug}}" }
        },
        {
          "name": "Get category tree",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories" }
        },
        {
          "name": "Get category",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/categories/{{categorySlug}}" }
        },
        {
          "name": "Get category courses",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/categories/{{categorySlug}}/courses?page=0&size=20"
          }
        },
        {
          "name": "Get public instructor",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/instructors/{{instructorId}}" }
        }
      ]
    },
    {
      "name": "Course Instructor",
      "item": [
        {
          "name": "Create course",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Spring Boot Masterclass\",\n  \"shortDescription\": \"Build production-ready backend applications.\",\n  \"description\": \"Learn Spring Boot, PostgreSQL, Redis and Kafka.\",\n  \"price\": 499000,\n  \"level\": \"INTERMEDIATE\",\n  \"language\": \"Vietnamese\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/courses"
          }
        },
        {
          "name": "List my courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses?page=0&size=20"
          }
        },
        {
          "name": "Get my course",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}"
          }
        },
        {
          "name": "Update course",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Complete backend course with Spring Boot and PostgreSQL.\",\n  \"price\": 499000\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}"
          }
        },
        {
          "name": "Replace categories",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"categoryIds\": [\"{{categoryId}}\"]\n}" },
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/categories"
          }
        },
        {
          "name": "Replace requirements",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{\"content\":\"Basic Java knowledge\",\"sortOrder\":0}]\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/requirements"
          }
        },
        {
          "name": "Replace learning outcomes",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [{\"content\":\"Build REST APIs with Spring Boot\",\"sortOrder\":0}]\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/learning-outcomes"
          }
        },
        {
          "name": "Update thumbnail",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{instructorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"thumbnail_url\": \"courses/thumbnails/spring-boot.png\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/thumbnail"
          }
        },
        {
          "name": "Submit for review",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/submit-review"
          }
        },
        {
          "name": "Pause course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/pause"
          }
        },
        {
          "name": "Resume course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/resume"
          }
        },
        {
          "name": "Archive course",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}/archive"
          }
        },
        {
          "name": "Delete draft course",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{instructorToken}}" }],
            "url": "{{baseUrl}}/api/v1/instructor/courses/{{courseId}}"
          }
        }
      ]
    },
    {
      "name": "Admin Course and Category",
      "item": [
        {
          "name": "List courses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/courses?page=0&size=20&status=PENDING_REVIEW"
          }
