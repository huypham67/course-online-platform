            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/courses/{{courseId}}"
          }
        },
        {
          "name": "Approve course",
          "request": {
            "method": "POST",
