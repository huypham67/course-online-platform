{
  "info": {
    "_postman_id": "b9c3bb8a-7bdf-4bcf-9d3b-2a7d8c7a6d11",
    "name": "Online Course Platform API",
    "description": "Postman collection for the Online Course Platform APIs. Set baseUrl and credentials in the collection variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "learnerEmail", "value": "learner@example.com" },
    { "key": "learnerPassword", "value": "Password123" },
    { "key": "instructorEmail", "value": "instructor@example.com" },
    { "key": "instructorPassword", "value": "Password123" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "instructorId", "value": "replace-with-instructor-uuid" },
    { "key": "instructorToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "courseId", "value": "" },
    { "key": "courseSlug", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "categorySlug", "value": "java" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register learner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"{{learnerPassword}}\",\n  \"fullName\": \"Nguyen Van A\",\n  \"bio\": \"Backend developer who loves learning new technologies.\",\n  \"phone\": \"0905123456\",\n  \"dateOfBirth\": \"2003-05-20\",\n  \"occupation\": \"Software Engineer\",\n  \"learningGoal\": \"Become proficient in Spring Boot and Microservices\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register/learner"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has data', function () { pm.expect(pm.response.json().data).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Register instructor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{instructorEmail}}\",\n  \"password\": \"{{instructorPassword}}\",\n  \"fullName\": \"John Smith\",\n  \"bio\": \"I've been building backend systems for over 8 years.\",\n  \"phone\": \"+12025550123\",\n  \"headline\": \"Senior Java Backend Engineer & Technical Instructor\",\n  \"expertise\": \"Java, Spring Boot, Microservices, PostgreSQL\",\n  \"experienceYears\": 8,\n  \"websiteUrl\": \"https://johnsmith.dev\",\n  \"linkedinUrl\": \"https://www.linkedin.com/in/johnsmith\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register/instructor"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 201 Created', function () { pm.response.to.have.status(201); });",
                  "pm.test('Response has data', function () { pm.expect(pm.response.json().data).to.exist; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Login learner",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"{{learnerPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.access_token).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', data.access_token);",
                  "pm.collectionVariables.set('refreshToken', data.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });",
                  "const data = pm.response.json().data;",
                  "pm.expect(data.access_token).to.be.a('string').and.not.empty;",
                  "pm.collectionVariables.set('accessToken', data.access_token);",
                  "pm.collectionVariables.set('refreshToken', data.refresh_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 200 OK', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
